# ─── Backend API ─────────────────────────────────────────────────────────────
# URL of the NestJS backend (motiva-backend). MUST include the /api route
# prefix — the backend applies a global "api" prefix in main.ts, e.g.:
#   Dev:        http://localhost:4000/api
#   Production: https://api.motivaestate.com/api
VITE_API_BASE_URL=

# ─── Sanity (content resources — unchanged) ──────────────────────────────────
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=
VITE_SANITY_API_VERSION=
VITE_SANITY_WRITE_TOKEN=
